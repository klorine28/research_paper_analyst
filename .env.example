# Copy to .env (never commit .env). Document every new variable here with its
# default and why it exists; see CODING_STANDARDS.md > Configuration.
#
# --- LLM (extraction / narrative text; see ADR 0001 and src/.../llm.py) ---
#
# Anthropic API key. Required to run the real client; leave unset for offline
# runs, which use RecordedLlmClient. No safe default: the Anthropic client
# fails at construction when this is missing.
ANTHROPIC_API_KEY=
#
# Model IDs per tier. Defaults shown; override to pin or switch models.
# The default (capable) tier and the cheap tier for high-volume, low-stakes calls.
LLM_DEFAULT_MODEL=claude-sonnet-4-5
LLM_CHEAP_MODEL=claude-haiku-4-5
#
# Max output tokens per completion (default 16384). A long Paper's Extraction
# runs to ~5000 tokens; output cut off at this budget fails that Paper with a
# "cut off at max_tokens" reason, so raise it if you see one.
LLM_MAX_TOKENS=16384
#
# US dollars. A run launched from the dashboard whose estimated cost is above
# this asks for confirmation first (issue #70); the estimate itself is in the
# Pipeline page's collapsed "Run details". Default 1.00; 0 confirms every LLM
# run. Must be a non-negative number.
LLM_COST_CONFIRM_ABOVE=1.00
#
# --- Scholarly APIs (ingest --resolve, retrieve, saturation checks) ---
# How the tool identifies itself to OpenAlex and PubMed (ADR 0009). Both are
# optional; leave blank to use the APIs anonymously (slower and rate-limited).
#
# Contact email for OpenAlex's polite pool. Default: none. `--mailto` overrides.
OPENALEX_MAILTO=
#
# NCBI E-utilities API key: raises PubMed's limit from 3 to 10 requests/second.
# Default: none.
NCBI_API_KEY=
#
# Automatic saturation checks after detect (`saturate --auto`, chained by the
# Pipeline page): high-confidence gaps, at most 20 per run, cached 30 days.
# Default on; set to off to switch them off (on-demand checks still work).
SATURATE_AUTO=on
#
# --- Embeddings (optional `embeddings` extra; see src/.../embeddings.py) ---
# Used only when `uv sync --extra embeddings` has installed sentence-transformers;
# without it, limitation grouping runs LLM-only and these are ignored.
#
# Embedding model id and its pinned revision (recorded in candidate_gaps.json so
# a rerun gives the same vectors). Defaults shown.
EMBEDDING_MODEL=NeuML/pubmedbert-base-embeddings
EMBEDDING_REVISION=b79526d6ef3645e0df4530322e266f24c829f5ef
#
# Cosine at or above which two limitation statements from different Papers are
# offered to grouping as a merge hint. Default 0.65; must be in (0, 1].
LIMITATION_MERGE_THRESHOLD=0.65
#
# --- Dashboard (see ADR 0002 and src/.../dashboard/app.py) ---
# Folder holding the ingested corpus directories the dashboard offers for
# selection. Defaults to ./corpora; set it to point the app elsewhere.
RESEARCH_GAP_CORPORA_DIR=corpora
