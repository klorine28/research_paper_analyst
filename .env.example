# Copy to .env (never commit .env). Document every new variable here with its
# default and why it exists; see CODING_STANDARDS.md > Configuration.
#
# --- LLM (extraction / narrative text; see ADR 0001 and src/.../llm.py) ---
#
# Anthropic API key. Required to run the real client; leave unset for offline
# runs, which use RecordedLlmClient. No safe default: the Anthropic client
# fails at construction when this is missing.
ANTHROPIC_API_KEY=
#
# Model IDs per tier. Defaults shown; override to pin or switch models.
# The default (capable) tier and the cheap tier for high-volume, low-stakes calls.
LLM_DEFAULT_MODEL=claude-sonnet-4-5
LLM_CHEAP_MODEL=claude-haiku-4-5
#
# Max output tokens per completion (default 4096).
LLM_MAX_TOKENS=4096
#
# --- Scholarly APIs (ingest --resolve, retrieve, saturation checks) ---
# How the tool identifies itself to OpenAlex and PubMed (ADR 0009). Both are
# optional; leave blank to use the APIs anonymously (slower and rate-limited).
#
# Contact email for OpenAlex's polite pool. Default: none. `--mailto` overrides.
OPENALEX_MAILTO=
#
# NCBI E-utilities API key: raises PubMed's limit from 3 to 10 requests/second.
# Default: none.
NCBI_API_KEY=
#
# --- Dashboard (see ADR 0002 and src/.../dashboard/app.py) ---
# Folder holding the ingested corpus directories the dashboard offers for
# selection. Defaults to ./corpora; set it to point the app elsewhere.
RESEARCH_GAP_CORPORA_DIR=corpora
